# better-sqlite3@13 menyertakan prebuilt binary di dalam npm package
# (prebuilds/win32-x64.node, prebuilds/linux-x64.node, dll). Lewati lifecycle
# scripts (gyp auto-rebuild) agar `npm ci` tidak membutuhkan toolchain lokal
# (Python + Visual Studio) dan selalu memakai binary resmi yang sudah teruji.
ignore-scripts=true
